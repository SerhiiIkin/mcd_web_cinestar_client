{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "react",
    "<THIRD_PARTY_MODULES>",
    "^./(.*)$",
    "^../(.*)$",
    "@layouts/",
    "@pages/",
    "@context/",
    "@components/",
    "@routes/",
    "@store/",
    "@hooks/",
    "@utils/",
    "@assets/",
    "@variables/",
    "@modules/",
    "@providers/"
  ],
  "printWidth": 80,
  "tabWidth": 4,
  "trailingComma": "all",
  "singleQuote": true,
  "semi": true,
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
